# Chiave segreta Stripe (dashboard.stripe.com → Sviluppatori → Chiavi API)
STRIPE_SECRET_KEY=sk_test_...

# Opzionale: chiave RapidAPI per gli orari reali dei voli (AeroDataBox).
# Senza chiave il sito mostra un orario dimostrativo.
AERODATABOX_API_KEY=

# Password del pannello admin (/admin). Usa una password lunga e unica.
ADMIN_PASSWORD=
# Opzionale: chiave separata per firmare le sessioni admin (altrimenti si usa ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Email di conferma ordine. Senza configurazione le email non partono e i link degli ordini
# restano visibili nella pagina dopo il pagamento e nel pannello admin.
# Opzione 1 – Gmail: indirizzo Gmail e "password per le app" (myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASS=
# Facoltativi, per un server SMTP diverso da Gmail:
SMTP_HOST=
SMTP_PORT=
# Opzione 2 – Resend (resend.com), con un dominio verificato:
RESEND_API_KEY=
# Mittente, es.: Amanah <ordini@tuodominio.it> (con Gmail, di default l'indirizzo SMTP_USER)
EMAIL_FROM=
