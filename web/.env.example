# Chiave segreta Stripe (dashboard.stripe.com → Sviluppatori → Chiavi API)
STRIPE_SECRET_KEY=sk_test_...

# Opzionale: chiave RapidAPI per gli orari reali dei voli (AeroDataBox).
# Senza chiave il sito mostra un orario dimostrativo.
AERODATABOX_API_KEY=

# Password del pannello admin (/admin). Usa una password lunga e unica.
ADMIN_PASSWORD=
# Opzionale: chiave separata per firmare le sessioni admin (altrimenti si usa ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Email di conferma ordine (resend.com). Senza queste due variabili le email non partono
# e i link degli ordini restano visibili nella pagina dopo il pagamento e nel pannello admin.
RESEND_API_KEY=
# Mittente verificato su Resend, es.: Amanah <ordini@tuodominio.it>
EMAIL_FROM=
